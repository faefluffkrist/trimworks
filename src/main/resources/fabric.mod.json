{
  "schemaVersion": 1,
  "id": "trimworks",
  "version": "${version}",
  "name": "Trimworks",
  "description": "Makes armor trims matter with configurable trim effects, built-in pattern abilities, and material bonuses.",
  "authors": [
    "faefluffkrist"
  ],
  "license": "MIT",
  "icon": "assets/trimworks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.faefluffkrist.trimworks.TrimEffectsExtension"
    ],
    "client": [
      "com.faefluffkrist.trimworks.TrimEffectsTooltipClient"
    ],
    "modmenu": [
      "com.faefluffkrist.trimworks.configscreen.TrimEffectsModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "fabric-api": ">=0.155.2+26.2"
  },
  "suggests": {
    "modmenu": ">=20.0.1 <21"
  },
  "mixins": [
    "trimworks.mixins.json"
  ],
  "breaks": {
    "mr_trimeffects": "*"
  },
  "accessWidener": "trimworks.accesswidener"
}
